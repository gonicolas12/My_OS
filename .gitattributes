# Forcer les fins de ligne LF pour les fichiers exécutés/lus sous Linux
# (sinon les CRLF Windows cassent le shebang, systemd, et les configs de l'ISO).
*.sh text eol=lf
*.service text eol=lf
*.desktop text eol=lf
*.conf text eol=lf

# Profil ISO archiso (packaging/) — fichiers système, toujours en LF.
packaging/build_iso.sh text eol=lf
packaging/archiso/packages.x86_64 text eol=lf
packaging/archiso/airootfs/** text eol=lf
# Lanceurs sans extension dans le profil ISO (non couverts par *.sh).
packaging/archiso/airootfs/usr/local/bin/* text eol=lf
