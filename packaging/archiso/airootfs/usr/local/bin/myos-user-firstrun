#!/bin/sh
# Initialisation au 1er lancement de session (idempotent) :
#   - crée un venv Python réutilisant les paquets système (--system-site-packages) ;
#   - installe les dépendances absentes des dépôts officiels (PyPI) ;
#   - récupère le modèle local Ollama EN ARRIÈRE-PLAN (réseau requis, non bloquant).
# Cohérent avec « local par défaut » : le modèle tourne ensuite sur la machine.
set -eu

base="$HOME/.local/share/my_os"
venv="$base/venv"
mark="$base/.firstrun-done"
log="$base/firstrun.log"
model="qwen3.5:4b"
# Espace libre exigé avant le pull : modèle (~3,3 Go) + marge. En live, l'écriture
# va dans le cowspace en RAM : sans cette garde, le pull le remplit et casse la session.
model_min_free_mib=4096

[ -f "$mark" ] && exit 0
mkdir -p "$base"

if [ ! -x "$venv/bin/python" ]; then
    python -m venv --system-site-packages "$venv"
fi

# Dépendances PyPI-only (les autres viennent des paquets système via le venv).
# En cas d'échec (ex. pas de réseau), on ne pose PAS le marqueur : nouvel essai
# à la prochaine session, et la cause reste lisible dans $log.
"$venv/bin/pip" install --quiet --upgrade pip >>"$log" 2>&1 || true
if ! "$venv/bin/pip" install --quiet pynput anthropic ollama >>"$log" 2>&1; then
    echo "myos-user-firstrun : échec de pip (voir $log) ; nouvel essai à la prochaine session" >&2
    exit 1
fi

# Récupération du modèle local (peut être longue ; ne bloque pas la session).
# Sans réseau, l'assistant signalera l'absence de modèle jusqu'au prochain
# `ollama pull qwen3.5:4b`.
free_mib="$(df -Pm /var/lib/ollama | awk 'NR==2 {print $4}')"
if [ "${free_mib:-0}" -ge "$model_min_free_mib" ]; then
    ( ollama pull "$model" >"$base/model-pull.log" 2>&1 || true ) &
else
    echo "Modèle $model non téléchargé : ${free_mib:-0} Mio libres, $model_min_free_mib requis." \
        "En live, démarrez avec plus de RAM, puis lancez : ollama pull $model" \
        >"$base/model-pull.log"
fi

touch "$mark"
