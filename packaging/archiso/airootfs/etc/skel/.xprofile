# shellcheck shell=sh
# My_OS — initialisation de la session X (Xfce/X11), sourcée au démarrage de session.
# 0) Contrôle de l'ordinateur : les applications exposent leur arbre d'accessibilité
#    (Chromium et Electron ne le lisent qu'à leur démarrage ; GTK l'expose toujours).
export GNOME_ACCESSIBILITY=1 ACCESSIBILITY_ENABLED=1 QT_LINUX_ACCESSIBILITY_ALWAYS_ON=1
# 1) Le daemon (service utilisateur) a besoin de DISPLAY/XAUTHORITY, comme les avis du
#    bureau du 1er démarrage : on les importe d'abord dans le gestionnaire systemd
#    utilisateur.
systemctl --user import-environment DISPLAY XAUTHORITY
# 2) Première exécution (idempotent, cf. myos-user-firstrun) : le venv tout de suite ;
#    dépendances et modèle en tâche de fond, sans retarder la session. Le script démarre
#    lui-même myosd une fois les dépendances installées.
/usr/local/bin/myos-user-firstrun
# 3) (Re)démarre myosd pour CETTE session : après une reconnexion en moins de ~10 s,
#    le gestionnaire systemd utilisateur survit, et le myosd de la session précédente
#    avec lui, son raccourci resté sur l'ancien serveur X (un « start » ne ferait rien).
#    Sans effet tant que les dépendances du 1er démarrage manquent (ConditionPathExists
#    de myosd.service) : le script le démarre alors lui-même.
systemctl --user restart myosd.service
# Le popup résident est lancé par l'autostart XDG (~/.config/autostart/myos-popup.desktop).
